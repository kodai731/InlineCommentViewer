{
  "name": "inline-comment-viewer",
  "displayName": "Inline Comment Viewer",
  "description": "GitHub のインラインコメントのようなスレッドで Claude と会話する",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository --skip-license --out inline-comment-viewer.vsix",
    "install-extension": "npm run package && code --install-extension inline-comment-viewer.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.6.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Inline Comment Viewer",
      "properties": {
        "inlineComment.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Claude Code CLI の実行ファイル名またはパス"
        }
      }
    },
    "configurationDefaults": {
      "comments.maxHeight": false
    },
    "commands": [
      {
        "command": "inlineComment.showMoreComments",
        "title": "省略中のコメントをさらに表示"
      },
      {
        "command": "inlineComment.addComment",
        "title": "Comment"
      },
      {
        "command": "inlineComment.sendThread",
        "title": "このスレッドを Claude に送信",
        "icon": "$(send)"
      },
      {
        "command": "inlineComment.sendAll",
        "title": "Inline Comment: 未送信コメントを一斉送信",
        "icon": "$(send)"
      },
      {
        "command": "inlineComment.startNewSession",
        "title": "Inline Comment: 新しい Claude セッションを開始"
      },
      {
        "command": "inlineComment.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "inlineComment.unresolveThread",
        "title": "Unresolve",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "inlineComment.deleteThread",
        "title": "スレッドを削除",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "inlineComment.showMoreComments",
          "when": "false"
        },
        {
          "command": "inlineComment.addComment",
          "when": "false"
        },
        {
          "command": "inlineComment.sendThread",
          "when": "false"
        },
        {
          "command": "inlineComment.resolveThread",
          "when": "false"
        },
        {
          "command": "inlineComment.unresolveThread",
          "when": "false"
        },
        {
          "command": "inlineComment.deleteThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "inlineComment.addComment",
          "group": "inline@1",
          "when": "commentController == inlineComment"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "inlineComment.sendThread",
          "group": "navigation@1",
          "when": "commentController == inlineComment && commentThread == unresolved"
        },
        {
          "command": "inlineComment.resolveThread",
          "group": "navigation@2",
          "when": "commentController == inlineComment && commentThread == unresolved"
        },
        {
          "command": "inlineComment.unresolveThread",
          "group": "navigation@2",
          "when": "commentController == inlineComment && commentThread == resolved"
        },
        {
          "command": "inlineComment.deleteThread",
          "group": "navigation@3",
          "when": "commentController == inlineComment"
        }
      ],
      "editor/title": [
        {
          "command": "inlineComment.sendAll",
          "group": "navigation",
          "when": "inlineComment.hasPendingComments"
        }
      ]
    }
  }
}
